md("## 8. Entrenamiento (con EarlyStopping y ReduceLROnPlateau)")

code(r"""
def make_callbacks():
    return [
        tf.keras.callbacks.EarlyStopping(monitor="val_loss", patience=10, restore_best_weights=True),
        tf.keras.callbacks.ReduceLROnPlateau(monitor="val_loss", factor=0.5, patience=4, min_lr=1e-6),
    ]

EPOCHS = 40
BATCH_SIZE = 256

t0 = time.time()
hist_lstm = lstm_model.fit(
    X_train_s, y_train, validation_data=(X_val_s, y_val),
    epochs=EPOCHS, batch_size=BATCH_SIZE, class_weight=class_weight,
    callbacks=make_callbacks(), verbose=2)
t_lstm = time.time() - t0
print(f"\nTiempo de entrenamiento LSTM: {t_lstm:.1f} s | épocas ejecutadas: {len(hist_lstm.history['loss'])}")
""")

code(r"""
t0 = time.time()
hist_gru = gru_model.fit(
    X_train_s, y_train, validation_data=(X_val_s, y_val),
    epochs=EPOCHS, batch_size=BATCH_SIZE, class_weight=class_weight,
    callbacks=make_callbacks(), verbose=2)
t_gru = time.time() - t0
print(f"\nTiempo de entrenamiento GRU: {t_gru:.1f} s | épocas ejecutadas: {len(hist_gru.history['loss'])}")
""")

