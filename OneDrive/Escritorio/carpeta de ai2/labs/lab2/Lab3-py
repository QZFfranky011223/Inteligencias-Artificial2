md("## 10. Evaluación en el conjunto de prueba (test set, nunca visto)")

code(r"""
def evaluate_model(model, name):
    y_prob = model.predict(X_test_s, verbose=0)
    y_pred = y_prob.argmax(axis=1)
    acc = accuracy_score(y_test, y_pred)
    f1m = f1_score(y_test, y_pred, average="macro")
    print(f"=== {name} ===")
    print(f"Accuracy test: {acc:.4f}   |   F1-macro test: {f1m:.4f}\n")
    print(classification_report(y_test, y_pred, target_names=CLASS_NAMES, digits=3))
    return y_pred, y_prob, acc, f1m

y_pred_lstm, y_prob_lstm, acc_lstm, f1_lstm = evaluate_model(lstm_model, "LSTM")
""")

