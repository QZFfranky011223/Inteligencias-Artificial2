code(r"""
NUMERIC_COLS = ["PM2.5", "PM10", "SO2", "NO2", "CO", "O3",
                 "TEMP", "PRES", "DEWP", "RAIN", "WSPM"]

# Interpolación temporal por estación (no mezcla información entre estaciones)
for col in NUMERIC_COLS:
    df[col] = df.groupby("station")[col].transform(lambda s: s.interpolate(limit_direction="both"))
df["wd"] = df.groupby("station")["wd"].transform(lambda s: s.ffill().bfill())

print("Valores faltantes tras imputación:", df[NUMERIC_COLS + ["wd"]].isna().sum().sum())
""")

