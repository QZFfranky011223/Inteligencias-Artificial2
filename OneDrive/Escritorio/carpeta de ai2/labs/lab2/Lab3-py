md("""## 4. Ingeniería de características

- Dirección del viento (`wd`, categórica) → codificación cíclica (seno/coseno) tras
  convertirla a grados.
- Hora y mes → codificación cíclica (para que 23h y 0h, o diciembre y enero, queden
  cerca en el espacio de características).
- Estación de monitoreo → codificación one-hot (12 columnas).
- Variable objetivo: categoría de AQI calculada a partir de PM2.5 (ver tabla de la
  introducción).""")

code(r"""
WD_TO_DEG = {
    "N": 0, "NNE": 22.5, "NE": 45, "ENE": 67.5, "E": 90, "ESE": 112.5,
    "SE": 135, "SSE": 157.5, "S": 180, "SSW": 202.5, "SW": 225, "WSW": 247.5,
    "W": 270, "WNW": 292.5, "NW": 315, "NNW": 337.5,
}
wd_deg = df["wd"].map(WD_TO_DEG).fillna(0)
df["wd_sin"] = np.sin(np.deg2rad(wd_deg)); df["wd_cos"] = np.cos(np.deg2rad(wd_deg))
df["hour_sin"] = np.sin(2*np.pi*df["hour"]/24); df["hour_cos"] = np.cos(2*np.pi*df["hour"]/24)
df["month_sin"] = np.sin(2*np.pi*df["month"]/12); df["month_cos"] = np.cos(2*np.pi*df["month"]/12)

AQI_BINS = [-np.inf, 35, 75, 115, 150, 250, np.inf]
AQI_LABELS = ["Bueno", "Moderado", "Insalubre_sensibles", "Insalubre", "Muy_insalubre", "Peligroso"]
df["aqi_cat"] = pd.cut(df["PM2.5"], bins=AQI_BINS, labels=AQI_LABELS)

station_dummies = pd.get_dummies(df["station"], prefix="st")
df = pd.concat([df, station_dummies], axis=1)

FEATURE_COLS = (NUMERIC_COLS + ["wd_sin","wd_cos","hour_sin","hour_cos","month_sin","month_cos"]
                 + list(station_dummies.columns))
print(f"N° de variables de entrada por paso de tiempo: {len(FEATURE_COLS)}")
FEATURE_COLS
""")

